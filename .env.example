# =======================================================
# =============== PostgreSQL Configuration ==============
# =======================================================

DB_USERNAME="postgres"
DB_PASSWORD="postgres"
DB_NAME="messaging_db"

# =======================================================
# ================ Backend Configuration ================
# =======================================================

CLIENT_DOMAIN="http://localhost:3000"
OTP_VALIDATION_SECONDS=3600

# cookie
AUTH_COOKIE_NAME="session" # Also used in frontend

# jwt
JWT_SECRET="your-secret-jwt-key"
JWT_TOKEN_VALIDITY_SECONDS=86400

# sessions
SESSION_SECRET="your-secret-sesion-key"

# mail
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Database ORM configuration
DB_HOST="postgres"
DB_PORT=5432
DB_USERNAME="postgres"
DB_PASSWORD="postgres"

# =======================================================
# ================ RabbitMQ Configuration ===============
# =======================================================

# RabbitMQ configuration
RABBITMQ_HOST="rabbitmq"
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER="guest"
RABBITMQ_DEFAULT_PASS="guest"

# =======================================================
# =========== WebSocket Server Configuration ============
# =======================================================

SOCKET_RABBITMQ_USER="socket"
SOCKET_RABBITMQ_PASS="password"
SOCKET_PORT=4000

# =======================================================
# ============== Chat Worker Configuration ==============
# =======================================================

CHAT_WORKER_RABBITMQ_USER="chat-worker"
CHAT_WORKER_RABBITMQ_PASS="password"
CHAT_WORKER_QUEUE_NAME="chat-worker-queue"
CHAT_WORKER_PREFETCH_COUNT=10

# =======================================================
# ================ Frontend Configuration ===============
# =======================================================

API_BASE_URL="http://backend:4000"
SOCKET_IO_BASE_URL="http://localhost:4000"

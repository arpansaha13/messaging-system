{
  "name": "resilience-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "pnpm -w build && docker compose --env-file .env.test -f ../../compose.test.yaml --profile resilience up -d --remove-orphans",
    "test": "pnpm run setup && bash run-resilience.sh --no-teardown",
    "run": "pnpm exec vitest run",
    "teardown": "docker compose --env-file .env.test -f ../../compose.test.yaml --profile resilience down -v --remove-orphans"
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^2.4.3",
    "memjs": "^1.3.2",
    "pg": "^8.20.0",
    "vitest": "^4.0.18",
    "ws": "^8.20.0"
  }
}
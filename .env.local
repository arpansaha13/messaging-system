ENVIRONMENT="development"

# =======================================================
# ============== Logging Configuration ====================
# =======================================================
# LOG_LEVEL is used by all services: auth, backend, socket, chat-worker
LOG_LEVEL="debug"

# =======================================================
# ============== Auth System Configuration ==============
# =======================================================
# Note: Auth System is located outside this repository

# Auth System gRPC connection (used by Backend)
AUTH_SYSTEM_HOST="localhost:50051"

# Auth System Database (PostgreSQL)
AUTH_DB_HOST="localhost"
AUTH_DB_PORT=5433
AUTH_DB_USERNAME="user"
AUTH_DB_PASSWORD="password"
AUTH_DB_NAME="auth_db"
AUTH_DB_MAX_CONNECTIONS=80

# Auth System gRPC Configuration
GRPC_HOST="0.0.0.0"
GRPC_PORT=50051

# Auth System - Session Management
SESSION_TTL_MINUTES=30
SESSION_CLEANUP_INTERVAL_MINUTES=5

# Auth System - Security
SECRET_KEY="your-secret-key-change-in-production-min-32-chars"
JWT_SECRET="your-jwt-secret-change-in-production"

# Auth System - Email (Mock for development)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@example.me"

# Auth System - OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Auth System - Worker Pool
EMAIL_WORKER_POOL_SIZE=5
EMAIL_TASK_QUEUE_SIZE=100

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# =======================================================
# ============= Messaging System Database ==============
# =======================================================

# Messaging System Database (PostgreSQL)
DB_HOST="localhost"
DB_PORT=5432
DB_USERNAME="user"
DB_PASSWORD="password"
DB_NAME="messaging_db"
DB_MAX_CONNECTIONS=80

# =======================================================
# ============= Kafka Configuration =====================
# =======================================================

KAFKA_BROKERS="localhost:9092"
KAFKA_TOPIC="application-logs"

# =======================================================
# ============= Grafana Loki Configuration ==============
# =======================================================

LOKI_HOST="localhost"
LOKI_PORT=3100

# =======================================================
# ============= Grafana Alloy Configuration =============
# =======================================================

ALLOY_HOST="localhost"
ALLOY_PORT=12345

# =======================================================
# ============= Grafana Dashboard Configuration ==========
# =======================================================

GF_SECURITY_ADMIN_USER="admin"
GF_SECURITY_ADMIN_PASSWORD="admin"
GF_LOG_LEVEL="info"

# =======================================================
# ================ Metrics Configuration ================
# =======================================================

# Port on which each Go service exposes Prometheus metrics (internal, not via nginx)
METRICS_PORT=9090

# Prometheus UI is available at http://localhost:7100 when running --profile metrics

# =======================================================
# ============= OpenTelemetry Configuration =============
# =======================================================

# OTLP gRPC endpoint for trace export (Tempo).
# Leave empty to disable trace export (no-op TracerProvider).
# In Docker Compose with --profile metrics: set to tempo:4317
OTLP_ENDPOINT="localhost:4317"

# =======================================================
# ================ Backend Configuration ================
# =======================================================

# Client domain
CLIENT_DOMAIN="http://localhost:7000"
OTP_VALIDATION_SECONDS=3600

# Cookie configuration (also used in frontend)
AUTH_COOKIE_NAME="session"

# JWT configuration
JWT_SECRET="your-secret-jwt-key"
JWT_TOKEN_VALIDITY_SECONDS=86400

# Session configuration
SESSION_SECRET="your-secret-session-key"

# =======================================================
# ================ RabbitMQ Configuration ===============
# =======================================================

# RabbitMQ server (shared by backend, socket, and chat-worker)
RABBITMQ_HOST="localhost"
RABBITMQ_PORT=5672
RABBITMQ_USER="guest"
RABBITMQ_PASS="guest"

# Backend RabbitMQ user credentials
BACKEND_RABBITMQ_USER="guest"
BACKEND_RABBITMQ_PASS="guest"

# WebSocket (Socket) RabbitMQ user credentials
SOCKET_RABBITMQ_USER="guest"
SOCKET_RABBITMQ_PASS="guest"

# Chat Worker RabbitMQ user credentials
CHAT_WORKER_RABBITMQ_USER="guest"
CHAT_WORKER_RABBITMQ_PASS="guest"
CHAT_WORKER_QUEUE_NAME="chat-worker-queue"
CHAT_WORKER_PREFETCH_COUNT=10

# =======================================================
# =========== WebSocket Server Configuration ============
# =======================================================

SOCKET_PORT=4004

# =======================================================
# ================ Frontend Configuration ===============
# =======================================================

# API and WebSocket URLs
# AUTH_COOKIE_NAME is specified under backend configuration.
NUXT_API_BASE_URL="http://localhost:7000"
NUXT_AUTH_COOKIE_NAME="session"


# =======================================================
# ================ Local service port variables ========
# =======================================================
AUTH_HTTP_PORT=4001
BACKEND_HTTP_PORT=4003
SOCKET_HTTP_PORT=4004
FRONTEND_PORT=3000

# Specific gRPC target ports/addresses for local mode
AUTH_SERVICE_GRPC_ADDR="localhost:50051"

# Local DB URLs
AUTH_DATABASE_URL="postgres://user:password@localhost:5433/auth_db?sslmode=disable"
BACKEND_DATABASE_URL="postgres://user:password@localhost:5432/messaging_db?sslmode=disable"

# Local service metrics ports
AUTH_METRICS_PORT=9090
BACKEND_METRICS_PORT=9092
SOCKET_METRICS_PORT=9093

# Local Memcached configuration
MEMCACHED_HOST="localhost"
MEMCACHED_PORT="11211"


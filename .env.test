ENVIRONMENT="test"

# Integration test dependency mode
# - container: suites start Postgres via Testcontainers (default if unset)
# - external: suites use the DSNs below
TEST_DEPS_MODE="external"

# Service-specific Postgres DSNs for external integration tests (preferred).
# These are fixed local-infra ports from setup-linux-local-integration.sh:
# - auth cluster:    6433
# - user cluster:    6434
# - default cluster: 6432 (shared by backend + chat-worker)
TEST_POSTGRES_DSN_AUTH="host=localhost port=6433 user=postgres dbname=auth_db sslmode=disable"
TEST_POSTGRES_DSN_BACKEND="host=localhost port=6432 user=postgres dbname=messaging_db sslmode=disable"
TEST_POSTGRES_DSN_USER="host=localhost port=6434 user=postgres dbname=users_db sslmode=disable"
TEST_POSTGRES_DSN_CHAT_WORKER="host=localhost port=6432 user=postgres dbname=messaging_db sslmode=disable"

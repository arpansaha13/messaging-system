ENVIRONMENT=test

# Integration test dependency mode
# - container: suites start Postgres via Testcontainers (default if unset)
# - external: suites use the DSNs below
TEST_DEPS_MODE="external"

# Optional global fallback DSN used by all services when service-specific DSNs are not set.
# TEST_POSTGRES_DSN="host=localhost port=5432 user=testuser password=testpass dbname=postgres sslmode=disable"

# Service-specific Postgres DSNs for integration tests (preferred)
# auth test DB (compose.test host exposure)
TEST_POSTGRES_DSN_AUTH="host=localhost port=7511 user=testuser password=testpass dbname=auth_db sslmode=disable"

# backend test DB
TEST_POSTGRES_DSN_BACKEND="host=localhost port=7020 user=user password=password dbname=messaging_db sslmode=disable"

# user service test DB
TEST_POSTGRES_DSN_USER="host=localhost port=7040 user=user password=password dbname=users_db sslmode=disable"

# chat-worker test DB (usually shares backend/messaging DB)
TEST_POSTGRES_DSN_CHAT_WORKER="host=localhost port=7020 user=user password=password dbname=messaging_db sslmode=disable"

FROM node:22-alpine AS builder

WORKDIR /app

# Enable corepack for pnpm
RUN npm i -g --force corepack && corepack enable

# Copy root workspace and package manifests
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY packages/constants/package.json ./packages/constants/
COPY packages/types/package.json ./packages/types/
COPY apps/chat-worker/package.json ./apps/chat-worker/
COPY apps/chat-worker/tsconfig.json ./apps/chat-worker/
COPY apps/chat-worker/tsconfig.build.json ./apps/chat-worker/

# Install dependencies
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
  pnpm install --frozen-lockfile

# Copy shared packages and build them
COPY packages ./packages
RUN pnpm -F @shared/constants build
RUN pnpm -F @shared/types build

# Copy chat-worker source and build
COPY apps/chat-worker ./apps/chat-worker
WORKDIR /app/apps/chat-worker
RUN pnpm build

# Production stage
FROM node:22-alpine

WORKDIR /app

# Enable corepack for pnpm
RUN npm i -g --force corepack && corepack enable

# Copy root workspace and package manifests
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY packages/constants/package.json ./packages/constants/
COPY packages/types/package.json ./packages/types/
COPY apps/chat-worker/package.json ./apps/chat-worker/

# Install production dependencies only
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
  pnpm install --frozen-lockfile --prod

# Copy built shared packages
COPY --from=builder /app/packages/constants/dist ./packages/constants/dist
COPY --from=builder /app/packages/types/dist ./packages/types/dist

# Copy built chat-worker
COPY --from=builder /app/apps/chat-worker/dist ./apps/chat-worker/dist
COPY --from=builder /app/apps/chat-worker/package.json ./apps/chat-worker/

WORKDIR /app/apps/chat-worker

CMD ["node", "-r", "reflect-metadata", "dist/index.js"]

# Chat Worker Go - Environment Configuration Example

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=messaging
DB_LOGGING=true

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Environment
ENVIRONMENT=development

# Logging
LOG_LEVEL=info

FROM node:22-alpine

WORKDIR /app

# Enable corepack for pnpm
RUN npm i -g --force corepack && corepack enable

# Copy root workspace and package manifests (for layer caching)
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY packages/constants/package.json ./packages/constants/
COPY packages/types/package.json ./packages/types/
COPY apps/socket/package.json ./apps/socket/
COPY apps/socket/tsconfig.json ./apps/socket/

# Install dependencies (uses buildkit cache if available)
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
  pnpm install --frozen-lockfile

# Copy shared packages and build them
COPY packages ./packages
RUN pnpm -F @shared/constants build
RUN pnpm -F @shared/types build

# Copy socket source
COPY apps/socket ./apps/socket

WORKDIR /app/apps/socket

EXPOSE 4000

# Use dev command (ts-node-dev) for hot reload inside container
CMD ["pnpm", "dev"]

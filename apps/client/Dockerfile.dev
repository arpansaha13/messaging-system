FROM node:22-alpine

WORKDIR /app

# Enable corepack
RUN npm i -g --force corepack && corepack enable

# Copy root workspace and package manifests (for layer caching)
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY packages/constants/package.json ./packages/constants/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY apps/client/package.json ./apps/client/

# Install dependencies
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
  pnpm install --frozen-lockfile

# Copy shared packages
COPY packages/constants ./packages/constants
COPY packages/types ./packages/types

# Build shared packages
RUN cd /app/packages/constants && pnpm build
RUN cd /app/packages/types && pnpm build

# Copy client app source
COPY apps/client ./apps/client

# Change to client directory
WORKDIR /app/apps/client

# Expose port
EXPOSE 3000

# Start development server with Next.js hot reload
CMD ["pnpm", "dev"]

FROM node:22-alpine

WORKDIR /app

# Enable corepack
RUN npm i -g --force corepack && corepack enable

# Copy root workspace and package manifests (for layer caching)
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY apps/frontend/package.json ./apps/frontend/

# Install dependencies
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
	pnpm install --frozen-lockfile

# Copy frontend app source
COPY apps/frontend ./apps/frontend

# Change to frontend directory
WORKDIR /app/apps/frontend

# Expose port
EXPOSE 3000

# https://github.com/nitrojs/nitro/issues/885#issuecomment-1404897317
RUN rm -rf /tmp/nitro/worker-*

# Start development server with Nuxt hot reload
CMD ["pnpm", "dev"]
